# CivicLens AI — Backend Environment Configuration

PROJECT_NAME="CivicLens AI"
ENV="development"
DEBUG=True

# Database Configuration:
# - For local quickstart: defaults to sqlite:///./civiclens.db
# - For PostgreSQL / Supabase: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL="sqlite:///./civiclens.db"

# Security (Change in production)
SECRET_KEY="civiclens-super-secret-development-key-2026-change-in-prod-xyz"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Vision & NLP AI Provider (Optional)
# If provided, image evidence will be analyzed with Gemini 1.5 Flash.
# If omitted, transparent deterministic rule-based heuristic will be used.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Municipal Duplicate Distance Threshold (in meters)
DUPLICATE_DISTANCE_THRESHOLD_METERS=150.0
